
<%@ page language="java"
    contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>PathFinder | Find Your Career</title>

    <link rel="stylesheet"
          href="CSS/index.css">

</head>

<body>


<!-- ================= NAVBAR ================= -->

<nav class="navbar">

    <div class="logo">
        <span class="logo-icon">P</span>
        <span>PathFinder</span>
    </div>

    <div class="nav-links">

        <a href="index.jsp">Home</a>

        

        <a href="#features">Features</a>

        <a href="login.jsp">Login</a>

        <a href="register.jsp" class="register-btn">
            Create Account
        </a>

        <a href="adminLogin.jsp" class="admin-btn">
            ⚙ Admin Login
        </a>

    </div>

</nav>


<!-- ================= HERO ================= -->

<section class="hero">

    <div class="hero-left">

        <div class="badge">
            ✦ SMART CAREER DISCOVERY
        </div>


        <h1>

            Find the career
            <br>

            that fits
            <span>you.</span>

        </h1>


        <p>

            PathFinder helps you discover your strengths,
            evaluate your skills and find suitable career
            opportunities through an intelligent online
            assessment system.

        </p>


        <div class="hero-buttons">

            <a href="register.jsp"
               class="primary-btn">

                Start Your Journey →

            </a>


            <a href="#how"
               class="secondary-btn">

                See How It Works

            </a>

        </div>

    </div>


    <!-- ================= CAREER PREVIEW ================= -->

    <div class="hero-right">

        <div class="career-card">


            <div class="card-top">

                <span class="card-title">
                    YOUR CAREER INSIGHT
                </span>

                <span class="ai-badge">
                    SMART MATCH
                </span>

            </div>


            <div class="match">

                <div class="circle">
                    92%
                </div>


                <div class="match-info">

                    <h2>
                        Data Analyst
                    </h2>

                    <p>
                        Strong career compatibility
                    </p>

                </div>

            </div>


            <div class="card-divider"></div>


            <div class="skills-title">
                Recommended Skills
            </div>


            <div class="skills">

                <span class="skill">
                    SQL
                </span>

                <span class="skill">
                    Python
                </span>

                <span class="skill">
                    Excel
                </span>

                <span class="skill">
                    Statistics
                </span>

                <span class="skill">
                    Data Visualization
                </span>

            </div>

        </div>

    </div>

</section>


<!-- ================= FEATURES ================= -->

<section class="features"
         id="features">


    <div class="section-label">
        PATHFINDER FEATURES
    </div>


    <h2>
        Everything you need
        to find your direction
    </h2>


    <p class="section-description">

        Assess your abilities, understand your performance
        and discover career opportunities that match
        your potential.

    </p>


    <div class="feature-grid">


        <div class="feature-card">

            <div class="feature-icon">
                🧠
            </div>

            <h3>
                Online Assessment
            </h3>

            <p>

                Test your aptitude, logical reasoning,
                technical skills and communication abilities
                through an online assessment.

            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                🎯
            </div>

            <h3>
                Career Recommendation
            </h3>

            <p>

                Receive a career recommendation based on
                your assessment performance and
                compatibility.

            </p>

        </div>


        <div class="feature-card">

            <div class="feature-icon">
                📊
            </div>

            <h3>
                Performance Analysis
            </h3>

            <p>

                View your score, percentage and assessment
                performance to understand your strengths.

            </p>

        </div>

    </div>

</section>


<!-- ================= HOW IT WORKS ================= -->

<section class="how"
         id="how">


    <div class="section-label">
        SIMPLE PROCESS
    </div>


    <h2>
        How PathFinder Works
    </h2>


    <p class="section-description">

        Your journey from assessment to career
        recommendation in four simple steps.

    </p>


    <div class="steps">


        <div class="step">

            <div class="step-number">
                01
            </div>

            <h3>
                Register
            </h3>

            <p>
                Create your PathFinder account.
            </p>

        </div>


        <div class="step">

            <div class="step-number">
                02
            </div>

            <h3>
                Take Assessment
            </h3>

            <p>
                Complete questions designed
                to evaluate your abilities.
            </p>

        </div>


        <div class="step">

            <div class="step-number">
                03
            </div>

            <h3>
                Get Results
            </h3>

            <p>
                Your assessment is evaluated
                automatically.
            </p>

        </div>


        <div class="step">

            <div class="step-number">
                04
            </div>

            <h3>
                Find Your Career
            </h3>

            <p>
                Receive your personalized
                career recommendation.
            </p>

        </div>

    </div>

</section>


<!-- ================= CTA ================= -->

<section class="cta">

    <h2>
        Ready to discover your career?
    </h2>

    <p>
        Take the first step toward understanding
        your potential.
    </p>

    <a href="register.jsp">
        Start Your Assessment →
    </a>

</section>


